{
  "name": "dsh-raw-html",
  "version": "0.7.0",
  "description": "VCP 视觉通感协议插件：现代 DSH 使用官方 assistant slot 隔离渲染 HTML，旧版保留 legacy patch 兼容",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "vcp",
    "visual-synesthesia",
    "html",
    "rendering"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "test:modern": "node --test tests/slot-renderer.test.mjs",
    "test:legacy": "node tests/security.test.mjs && node tests/smoke.test.mjs && node tests/stable.test.mjs && node tests/math.test.mjs && node tests/mermaid.test.mjs && node tests/trusted.test.mjs && node tests/boost-fontface.test.cjs",
    "test": "npm run test:modern && npm run test:legacy"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "assets",
    "patch/*.js",
    "patch/*.cjs",
    "tools/*.cjs",
    "tools/*.py",
    "tests/*.mjs",
    "tests/*.cjs",
    "docs",
    "cordis.patch.yml",
    "DESIGN.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "VCP-INTERACTIONS.md",
    "FRAMING.md",
    "EDITORIAL.md",
    "BREATH.md",
    "styles",
    "examples",
    "fonts-index.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "react",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.3.1"
  },
  "license": "MIT",
  "optionalDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "jsdom": "^30.0.1"
  }
}
